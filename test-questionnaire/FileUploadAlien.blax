DATAMODEL FileUploadAlien

PRIMARY ID

INCLUDE "bFile.incx"

BLOCK bReceipts
FIELDS
   Files : ARRAY[1..10] OF bFile
LOCALS
    i : INTEGER
RULES
   FOR i := 1 TO 10 DO
      IF i = 1 OR Files[i-1].FileId = RESPONSE THEN
         Files[i]('Files_'+STR(i))
      ENDIF
   ENDDO
ENDBLOCK //bReceipts

FIELDS

  ID : INTEGER[4]
  Receipts : bReceipts
  Last : STRING, EMPTY
  
RULES
   ID.keep
   Receipts
   Last

LAYOUT
   BEFORE Last NEWPAGE
ENDMODEL
